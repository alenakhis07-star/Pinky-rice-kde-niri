// Сочетания: твои из прошлого niri + то, к чему привыкла в KDE + удобное из val-niri
binds {
    // --- программы ---
    Mod+Return hotkey-overlay-title="Терминал" { spawn "kitty"; }
    Mod+E      hotkey-overlay-title="Файлы"    { spawn "nautilus" "--new-window"; }
    Mod+B      hotkey-overlay-title="Firefox"  { spawn "firefox"; }
    Mod+D      hotkey-overlay-title="Запуск программ" { spawn-sh "pkill -x rofi || rofi -show drun -modi drun,run"; }
    Mod+V      hotkey-overlay-title="Буфер обмена" { spawn "~/.local/bin/pinky-clipboard"; }
    Mod+Shift+V { spawn-sh "cliphist wipe; wl-copy --clear; notify-send -a Буфер 'Буфер обмена' 'История очищена'"; }
    Mod+W      hotkey-overlay-title="Сменить обои" { spawn "~/.local/bin/pinky-wallpaper"; }
    Mod+L      hotkey-overlay-title="Заблокировать" { spawn "~/.local/bin/pinky-lock"; }
    Mod+P      hotkey-overlay-title="Меню сеанса" { spawn "~/.local/bin/pinky-power"; }
    Ctrl+Alt+Delete { spawn "~/.local/bin/pinky-power"; }
    Mod+Shift+E     { quit; }
    Mod+Shift+Slash { show-hotkey-overlay; }

    // --- окна ---
    Mod+Q repeat=false { close-window; }
    Mod+F              { fullscreen-window; }
    Mod+M              { maximize-column; }
    Mod+Ctrl+F         { maximize-window-to-edges; }
    Mod+Ctrl+Shift+F   { expand-column-to-available-width; }
    Mod+Shift+Space    { toggle-window-floating; }
    Mod+Ctrl+Space     { switch-focus-between-floating-and-tiling; }
    Mod+O repeat=false { toggle-overview; }
    Mod+T              { toggle-column-tabbed-display; }

    // раскладка клавиатуры — как в KDE
    Mod+Space { switch-layout "next"; }

    // фокус: колонки влево/вправо, окна вверх/вниз
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Mod+Home  { focus-column-first; }
    Mod+End   { focus-column-last; }

    // двигать окна внутри экрана
    Mod+Alt+Left  { move-column-left; }
    Mod+Alt+Right { move-column-right; }
    Mod+Alt+Up    { move-window-up; }
    Mod+Alt+Down  { move-window-down; }

    // мониторы: Ctrl+Super+Shift+стрелка — перенести окно, Super+Shift+стрелка — перейти на другой монитор
    Mod+Ctrl+Shift+Left  { move-column-to-monitor-left; }
    Mod+Ctrl+Shift+Right { move-column-to-monitor-right; }
    Mod+Ctrl+Shift+Up    { move-column-to-monitor-up; }
    Mod+Ctrl+Shift+Down  { move-column-to-monitor-down; }
    Mod+Shift+Left       { focus-monitor-left; }
    Mod+Shift+Right      { focus-monitor-right; }
    Mod+Shift+Up         { focus-monitor-up; }
    Mod+Shift+Down       { focus-monitor-down; }

    // рабочие столы: Super+Ctrl+стрелки, колесо, цифры
    Mod+Ctrl+Left  { focus-workspace-down; }
    Mod+Ctrl+Right { focus-workspace-up; }
    Mod+Ctrl+Down  { focus-workspace-down; }
    Mod+Ctrl+Up    { focus-workspace-up; }
    Mod+Page_Down  { focus-workspace-down; }
    Mod+Page_Up    { focus-workspace-up; }
    Mod+Shift+Page_Down { move-column-to-workspace-down; }
    Mod+Shift+Page_Up   { move-column-to-workspace-up; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }
    Mod+Shift+WheelScrollDown cooldown-ms=50 { focus-column-right; }
    Mod+Shift+WheelScrollUp   cooldown-ms=50 { focus-column-left; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+Shift+0 { move-column-to-workspace 10; }

    // колонки и размеры (из val-niri)
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma        { consume-window-into-column; }
    Mod+Period       { expel-window-from-column; }
    Mod+R            { switch-preset-column-width; }
    Mod+Shift+R      { switch-preset-window-height; }
    Mod+Ctrl+R       { reset-window-height; }
    Mod+Minus        { set-column-width "-5%"; }
    Mod+Equal        { set-column-width "+5%"; }
    Mod+Shift+Minus  { set-window-height "-5%"; }
    Mod+Shift+Equal  { set-window-height "+5%"; }

    // --- скриншоты ---
    Print      { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print  { screenshot-window; }
    Mod+Shift+S { screenshot; }

    // --- звук, яркость, плеер (с всплывающим уведомлением) ---
    XF86AudioRaiseVolume allow-when-locked=true { spawn "~/.local/bin/pinky-osd" "vol-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "~/.local/bin/pinky-osd" "vol-down"; }
    XF86AudioMute        allow-when-locked=true { spawn "~/.local/bin/pinky-osd" "vol-mute"; }
    XF86AudioMicMute     allow-when-locked=true { spawn "~/.local/bin/pinky-osd" "mic-mute"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "~/.local/bin/pinky-osd" "br-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "~/.local/bin/pinky-osd" "br-down"; }
    XF86AudioPlay  allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPause allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext  allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev  allow-when-locked=true { spawn "playerctl" "previous"; }

    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
}
