// Alt+Tab — по всем окнам на всех рабочих столах (как в KDE)
recent-windows {
    binds {
        Alt+Tab         { next-window scope="all"; }
        Alt+Shift+Tab   { previous-window scope="all"; }
    }
}

blur {
    passes 3
    offset 3
    noise 0.013
    saturation 1.3
}

// у всех окон мягко скруглённые углы
window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
    draw-border-with-background false
}

window-rule {
    match app-id="kitty"
    background-effect { blur true; }
}

window-rule {
    match app-id="org.kde.dolphin"
    match app-id="org.gnome.Nautilus"
    background-effect { blur true; }
}

window-rule {
    match app-id="[Ss]potify$"
    opacity 0.92
    background-effect { blur true; }
}

// маленькие окна — плавающие
window-rule {
    match app-id="org.kde.kcalc"
    match app-id="pavucontrol"
    match app-id="org.pulseaudio.pavucontrol"
    match app-id="org.kde.polkit-kde-authentication-agent-1"
    match app-id="nm-connection-editor"
    match title="^Picture-in-Picture$"
    match title="^Картинка в картинке$"
    open-floating true
}

window-rule {
    match app-id="xdg-desktop-portal-gtk"
    match app-id="org.freedesktop.impl.portal.desktop.kde"
    default-column-width { fixed 1000; }
    default-window-height { fixed 700; }
    open-floating true
    background-effect { blur true; }
}

// Steam: главное окно — развёрнуто, остальные (друзья, настройки, диалоги) — плавающие
window-rule {
    match app-id="^[Ss]team$" title="^Steam$"
    open-maximized true
}
window-rule {
    match app-id="^[Ss]team$"
    exclude title="^Steam$"
    open-floating true
}
// всплывающие уведомления Steam — в правом нижнем углу, без перехвата фокуса
window-rule {
    match app-id="^[Ss]team$" title=r#"^notificationtoasts_\d+_desktop$"#
    open-floating true
    open-focused false
    default-floating-position x=12 y=12 relative-to="bottom-right"
}

layer-rule {
    match namespace="^waybar$"
    background-effect { blur true; }
}

layer-rule {
    match namespace="^rofi$"
    background-effect { blur true; }
}

layer-rule {
    match namespace="^notifications$"
    background-effect { blur true; }
}

layer-rule {
    match namespace="^awww-daemon$"
    place-within-backdrop true
}
