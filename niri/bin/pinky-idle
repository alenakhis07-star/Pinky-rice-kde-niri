#!/usr/bin/env bash
# Бездействие в niri: 8 мин — притушить, 10 мин — заблокировать и погасить экраны, 15 мин — сон.
# Кнопка «кофеин» в баре (idle_inhibitor) отключает всё это, пока включена.
exec swayidle -w \
    timeout 480 'brightnessctl -s set 10%' resume 'brightnessctl -r' \
    timeout 600 '~/.local/bin/pinky-lock' \
    timeout 610 'niri msg action power-off-monitors' resume 'niri msg action power-on-monitors' \
    timeout 900 'systemctl suspend' \
    before-sleep '~/.local/bin/pinky-lock'
