#!/usr/bin/env bash
# Super+W: следующие обои по кругу. Работает и в KDE, и в niri.
shopt -s nullglob nocaseglob
mapfile -t W < <(printf '%s\n' ~/.local/share/wallpapers/*.{png,jpg,jpeg,webp} \
                               ~/Изображения/Wallpapers/*.{png,jpg,jpeg,webp} | sort)
[ ${#W[@]} -eq 0 ] && exit 0
state=~/.cache/pinky-wallpaper-index
i=$(( ( $(cat "$state" 2>/dev/null || echo -1) + 1 ) % ${#W[@]} ))
echo "$i" > "$state"
img="${W[$i]}"
if [ "${XDG_CURRENT_DESKTOP:-}" = "niri" ]; then
  awww img "$img" --transition-type grow --transition-pos 0.5,0.5 --transition-duration 1.2
  echo "$img" > ~/.config/wallpaper
else
  plasma-apply-wallpaperimage "$img" >/dev/null
fi
notify-send -a "Обои" -i preferences-desktop-wallpaper "Обои" "$(basename "$img")"
